# Copy to .env (never commit .env). Used by `cdk deploy` (channel identities) and local runs.
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-opus-5-5

# WhatsApp — AWS End User Messaging Social: phone number id of the linked WhatsApp Business number
WA_PHONE_NUMBER_ID=phone-number-id-xxxxxxxx
WA_META_API_VERSION=v20.0
# SMS / RCS — AWS End User Messaging (pinpoint-sms-voice-v2)
RCS_AGENT_ID=arn-or-id-of-rcs-testing-agent
SMS_ORIGINATION_IDENTITY=+18885550100
SMS_CONFIGURATION_SET=tripclaim
# Demo only: SMS/RCS go to the phone simulator (/phone) instead of a carrier. Never in production.
SIM_PHONE=
# Demo only: the English persona's email, so the decision letter goes out by SES (sandbox: a verified address)
DEMO_EMAIL=
# Email — Amazon SES
EMAIL_FROM=claims@claims.example.com
CLAIMS_INBOX=claim@claims.example.com
REVIEWER_EMAIL=reviewer@example.com

# Local only
TRIPCLAIM_STORE=memory          # memory | dynamodb
TRIPCLAIM_CHANNELS=fake         # fake | live
LLM_BACKEND=sdk                 # sdk (Claude Agent SDK, your Claude login) | bedrock | cli (claude -p) | fake
# Demo stack: payments at or above this amount wait for a second reviewer (default 300)
DUAL_APPROVAL_OVER_USD=
