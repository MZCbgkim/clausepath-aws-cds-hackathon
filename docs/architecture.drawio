<mxfile host="drawio"><diagram name="ClausePath"><mxGraphModel dx="1700" dy="1000" grid="0" page="1" pageWidth="1720" pageHeight="1040" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="ClausePath · travel-claim concierge on AWS Communication Developer Services" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="34" as="geometry"/></mxCell><mxCell id="n2" value="A text at the airport, a chat with sources, documents checked on the spot, the claim packet by email. The agent prepares; the insurer decides." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1300" height="24" as="geometry"/></mxCell><mxCell id="n3" value="Traveler&lt;br&gt;&lt;font color=&#x27;#5A6B86&#x27;&gt;text · web chat · email&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.mobile_client;fillColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="64" height="64" as="geometry"/></mxCell><mxCell id="n4" value="Insurer reviewers&lt;br&gt;&lt;font color=&#x27;#5A6B86&#x27;&gt;dashboard · claims inbox&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;fillColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="64" height="64" as="geometry"/></mxCell><mxCell id="n5" value="AWS Cloud · us-east-1" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsib