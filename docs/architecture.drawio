;fontSize=11;fontColor=#5A6B86;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="250"/><mxPoint x="600" y="250"/><mxPoint x="600" y="362"/></Array></mxGeometry></mxCell><mxCell id="n45" value="5" style="ellipse;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="586" y="286" width="28" height="28" as="geometry"/></mxCell><mxCell id="n46" value="claim packet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8D99AE;strokeWidth=2;fontSize=11;fontColor=#5A6B86;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="375"/><mxPoint x="200" y="790"/><mxPoint x="72" y="790"/></Array></mxGeometry></mxCell><mxCell id="n47" value="decision letter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8D99AE;strokeWidth=2;fontSize=11;fontColor=#5A6B86;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="349"/><mxPoint x="240" y="449"/></Array></mxGeometry></mxCell><mxCell id="n48" value="sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8D99AE;strokeWidth=2;fontSize=11;fontColor=#5A6B86;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="n4" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8D99AE;strokeWidth=2;fontSize=11;fontColor=#5A6B86;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="n18" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n50" value="6" style="ellipse;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="226" y="386" width="28" height="28" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;One claim:&lt;/b&gt; (1) flight cancelled → (2) traveler texted first, on the channel the router picks → (3) the same conversation continues in a web chat → (4) Claude reads photos and answers from the policy with sources; rules check dates, flight, place → (5) claim packet to the insurer by SES → (6) reviewers decide (two people for a partial payment or denial); the decision goes back by email and in the chat." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="1650" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>